# Copy this file to .env. Keep your completed .env private.
REVIEW_HOST_PORT=8088
REVIEW_ACCESS_TOKEN=

# OpenAI-compatible model provider; configure your own account.
REVIEW_GATEWAY_ENDPOINT=
REVIEW_GATEWAY_API_KEY=
REVIEW_GATEWAY_MODEL=

# Optional Azure connections, selected in Models and usage.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
REVIEW_AZURE_SCREENING_DEPLOYMENT=
REVIEW_AZURE_REASONING_DEPLOYMENT=
REVIEW_AZURE_API_VERSION=

# Optional Scopus retrieval access.
SCOPUS_API_KEY=
SCOPUS_INSTTOKEN=

# Advanced desktop integration requires reachable API and readable attachment paths.
REVIEW_ZOTERO_URL=http://host.docker.internal:23119
